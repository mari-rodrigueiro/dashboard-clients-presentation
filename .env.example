# Copie este arquivo para .env e preencha os valores antes de rodar o projeto.
# Ver SPECS.md §16 para o significado de cada variável.

# Banco SQLite embarcado — arquivo local, sem serviço separado (ver SPECS.md §8)
# Caminho relativo a backend/ (onde uvicorn/alembic/pytest rodam — ver README.md)
DATABASE_URL=sqlite+aiosqlite:///./cs_dashboard.db

# Backend
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Usuário único do sistema (login local) — só são lidas no primeiro start,
# quando a tabela de usuários está vazia (ver SPECS.md §15.1). Depois disso,
# a senha é trocada pela tela de Configurações, não por aqui.
ADMIN_EMAIL=
ADMIN_SEED_PASSWORD=

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ENV=development

# IA (chat com grounding direto no banco — ver SPECS.md §11)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Banco de testes do backend (SPECS.md §17) — SQLite em memória, usado só ao rodar pytest
DATABASE_URL_TEST=sqlite+aiosqlite:///:memory:
