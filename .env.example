# Copie este arquivo para .env e preencha os valores antes de rodar `docker compose up`.
# Ver SPECS.md §16 para o significado de cada variável.

# Postgres (usado pelo serviço `db` e montado em DATABASE_URL pelo docker-compose.yml)
POSTGRES_DB=cs_dashboard
POSTGRES_USER=cs_dashboard
POSTGRES_PASSWORD=

# Backend
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Usuário único do sistema (login local) — só são lidas no primeiro start,
# quando a tabela de usuários está vazia (ver SPECS.md §15.1). Depois disso,
# a senha é trocada pela tela de Configurações, não por aqui.
ADMIN_EMAIL=
ADMIN_SEED_PASSWORD=

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ENV=development

# IA (usada a partir da Fase 5 — ver SPECS.md §11)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Banco de testes do backend (SPECS.md §17) — usado só ao rodar pytest
DATABASE_URL_TEST=postgresql+asyncpg://cs_dashboard:cs_dashboard@db:5432/cs_dashboard_test
